# 데이터베이스 (SQLite 파일 경로)
DATABASE_URL="file:./storage/data/dshs-share.db"

# 서버 포트 (배포 플랫폼이 자동으로 PORT를 주입하면 그 값이 우선됩니다)
PORT=3000

# 회원가입을 허용할 이메일 도메인 (쉼표로 여러 개 지정 가능)
ALLOWED_EMAIL_DOMAINS=dshs.kr

# 이 이메일로 가입하면 자동으로 관리자 권한이 부여됩니다 (쉼표로 여러 개 지정 가능)
ADMIN_EMAILS=teacher@dshs.kr

# 회원가입 축하 포인트
SIGNUP_BONUS_POINTS=300

# 자료 업로드 최대 용량 (MB)
MAX_UPLOAD_MB=20

# 세션 쿠키 서명/식별에 사용하는 임의의 긴 문자열 (배포 시 반드시 무작위 값으로 교체하세요)
SESSION_SECRET=insecure-dev-secret-change-me

# 리버스 프록시 뒤 HTTPS 환경에서 배포할 때 true로 설정하면 세션 쿠키에 Secure 속성이 붙습니다
TRUST_PROXY_HTTPS=false
